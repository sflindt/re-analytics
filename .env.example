# UtahRealEstate.com RESO API credentials (optional — needed for Utah MLS data)
# Apply at https://vendor.utahrealestate.com/
RESO_API_TOKEN=your_bearer_token_here

# Rentcast API for rent estimates (optional — 50 free calls/month)
# Sign up at https://www.rentcast.io/api
RENTCAST_API_KEY=your_api_key_here

# Scrapfly API key for Zillow scraping (optional — Playwright is default)
# Only needed if Playwright fails. Free tier: 1,000 credits
# Sign up at https://scrapfly.io
SCRAPFLY_API_KEY=

# FRED API key for interest rates and home price appreciation (optional)
# Higher rate limits with key. Sign up at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Census Bureau API key for population data (optional)
# Sign up at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Anthropic API key for LLM-powered area research (optional)
# Required for community news section in reports
ANTHROPIC_API_KEY=

# Supabase — access gate for hosted deployment (optional)
# Create a free project at https://supabase.com
# Then run the SQL from src/re_analytics/auth.py to create the table
SUPABASE_URL=
SUPABASE_KEY=
